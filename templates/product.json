{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "social-proof": {
      "type": "vistil-social-proof",
      "blocks": {
        "stat-1": { "type": "stat", "settings": { "number": "10,000+", "label": "Happy customers" } },
        "stat-2": { "type": "stat", "settings": { "number": "4.9/5", "label": "Average rating" } },
        "stat-3": { "type": "stat", "settings": { "number": "30-day", "label": "Money-back guarantee" } }
      },
      "block_order": ["stat-1", "stat-2", "stat-3"],
      "settings": {
        "heading": "Trusted by thousands of customers",
        "color_scheme": "scheme-2",
        "padding_top": 40,
        "padding_bottom": 40
      }
    },
    "value-proposition": {
      "type": "vistil-value-proposition",
      "blocks": {
        "value-1": { "type": "value", "settings": { "icon": "truck", "heading": "Free shipping", "text": "<p>On every order, every time.</p>" } },
        "value-2": { "type": "value", "settings": { "icon": "lock", "heading": "Secure checkout", "text": "<p>Your data is always protected.</p>" } },
        "value-3": { "type": "value", "settings": { "icon": "return", "heading": "Easy returns", "text": "<p>30 days to change your mind.</p>" } },
        "value-4": { "type": "value", "settings": { "icon": "heart", "heading": "Loved by customers", "text": "<p>Thousands of 5-star reviews.</p>" } }
      },
      "block_order": ["value-1", "value-2", "value-3", "value-4"],
      "settings": {
        "heading": "Why VISTIL",
        "heading_size": "h1",
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "padding_top": 52,
        "padding_bottom": 52
      }
    },
    "benefits": {
      "type": "vistil-benefits",
      "blocks": {
        "benefit-1": {
          "type": "benefit",
          "settings": {
            "eyebrow": "Benefit 01",
            "heading": "Benefit heading",
            "text": "<p>Explain the benefit and why it matters to the customer.</p>",
            "bullet_1": "Key point one",
            "bullet_2": "Key point two",
            "bullet_3": "Key point three"
          }
        },
        "benefit-2": {
          "type": "benefit",
          "settings": {
            "eyebrow": "Benefit 02",
            "heading": "Another benefit",
            "text": "<p>Explain the second benefit and its impact.</p>",
