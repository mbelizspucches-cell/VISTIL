      "block_order": ["tier-1", "tier-2", "tier-3"],
      "settings": {
        "heading": "Choose your bundle",
        "cta_label": "Add to cart",
        "reassurance_text": "Free shipping · 30-day guarantee",
        "color_scheme": "scheme-1",
        "padding_top": 52,
        "padding_bottom": 52
      }
    },
    "transformation": {
      "type": "vistil-transformation",
      "settings": {
        "heading": "See the difference",
        "before_label": "Before",
        "after_label": "After",
        "color_scheme": "scheme-1",
        "padding_top": 52,
        "padding_bottom": 52
      }
    },
    "objections": {
      "type": "collapsible-content",
      "blocks": {
        "row-1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long does shipping take?",
            "row_content": "<p>Orders ship within 1-2 business days and arrive in 3-7 business days.</p>"
          }
        },
        "row-2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What if it doesn't work for me?",
            "row_content": "<p>You're covered by our 30-day money-back guarantee — no questions asked.</p>"
          }
        },
        "row-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is this safe to use?",
            "row_content": "<p>Yes. Add manufacturing, certification, or safety details here.</p>"
          }
        }
      },
      "block_order": ["row-1", "row-2", "row-3"],
      "settings": {
        "heading": "Common questions",
        "heading_size": "h1",
        "layout": "none",
        "container_color_scheme": "scheme-1",
        "color_scheme": "scheme-1",
        "open_first_collapsible_row": true,
        "padding_top": 52,
        "padding_bottom": 52
      }
    },
    "trust-guarantee": {
      "type": "vistil-trust-guarantee",
      "blocks": {
        "badge-1": { "type": "badge", "settings": { "icon": "lock", "text": "Secure checkout" } },
