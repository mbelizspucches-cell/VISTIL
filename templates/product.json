      "block_order": ["badge-1", "badge-2", "badge-3"],
      "settings": {
        "guarantee_icon": "checkmark",
        "guarantee_heading": "30-day money-back guarantee",
        "guarantee_text": "<p>Not happy? Get a full refund, no questions asked.</p>",
        "color_scheme": "scheme-2",
        "padding_top": 44,
        "padding_bottom": 44
      }
    },
    "reviews": {
      "type": "vistil-reviews",
      "blocks": {
        "review-1": {
          "type": "review",
          "settings": { "rating": 5, "text": "This product completely changed my routine. Worth every penny.", "author": "Happy customer", "verified": true }
        },
        "review-2": {
          "type": "review",
          "settings": { "rating": 5, "text": "Exactly as described, fast shipping, will buy again.", "author": "Verified buyer", "verified": true }
        },
        "review-3": {
          "type": "review",
          "settings": { "rating": 4, "text": "Great quality for the price.", "author": "Verified buyer", "verified": true }
        }
      },
      "block_order": ["review-1", "review-2", "review-3"],
      "settings": {
        "heading": "What customers are saying",
        "average_rating": "4.9",
        "review_count": "1,240",
        "color_scheme": "scheme-1",
        "padding_top": 52,
        "padding_bottom": 52
      }
