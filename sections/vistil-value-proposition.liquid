{{ 'vistil-theme.css' | asset_url | stylesheet_tag }}
{{ 'section-vistil-value-proposition.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="page-width section-{{ section.id }}-padding vistil-value-prop{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="vistil-heading vistil-center {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <div class="vistil-subheading vistil-center rte">{{ section.settings.subheading }}</div>
    {%- endif -%}

    <div class="vistil-value-prop__grid vistil-grid" style="--columns-desktop: {{ section.settings.columns_desktop }};">
      {%- for block in section.blocks -%}
        <div class="vistil-value-prop__item{% if settings.animations_reveal_on_scroll %} animate--slide-in{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <div class="vistil-icon vistil-value-prop__icon">
              {%- render 'icon-accordion', icon: block.settings.icon -%}
            </div>
          {%- endif -%}
          <div class="vistil-value-prop__item-body">
            {%- if block.settings.heading != blank -%}
              <h3 class="h4 vistil-value-prop__item-heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="vistil-value-prop__item-text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="vistil-value-prop__footnote vistil-center">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "VISTIL: Value proposition",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Más que cambiar las sábanas."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Secondary detail",
      "info": "Short line shown below the grid."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value prop",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "suction", "label": "VISTIL: Suction" },
            { "value": "uv_light", "label": "VISTIL: UV light" },
            { "value": "filter_grid", "label": "VISTIL: Filter" },
            { "value": "handheld", "label": "VISTIL: Compact device" },
            { "value": "eye", "label": "Eye" },
            { "value": "lightning-bolt", "label": "Lightning bolt" },
            { "value": "truck", "label": "Truck" },
            { "value": "lock", "label": "Lock" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "return", "label": "Return" },
            { "value": "star", "label": "Star" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "fire", "label": "Fire" },
            { "value": "box", "label": "Box" },
            { "value": "price-tag", "label": "Price tag" },
            { "value": "checkmark", "label": "Checkmark" },
            { "value": "padlock", "label": "Padlock" }
          ],
          "default": "checkmark"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Beneficio"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Descripción breve del beneficio.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VISTIL: Value proposition",
      "blocks": [
        { "type": "value", "settings": { "icon": "suction" } },
        { "type": "value", "settings": { "icon": "uv_light" } },
        { "type": "value", "settings": { "icon": "filter_grid" } },
        { "type": "value", "settings": { "icon": "handheld" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
