{{ 'vistil-theme.css' | asset_url | stylesheet_tag }}
{{ 'section-vistil-benefits.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="vistil-heading vistil-center {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="vistil-benefits">
      {%- for block in section.blocks -%}
        {%- assign is_reverse_row = forloop.index0 | modulo: 2 -%}
        <div
          class="vistil-benefits__row{% if is_reverse_row == 1 %} vistil-benefits__row--reverse{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="vistil-benefits__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '400, 600, 900, 1200'
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="vistil-benefits__content">
            {%- if block.settings.eyebrow != blank -%}
              <span class="vistil-eyebrow">{{ block.settings.eyebrow | escape }}</span>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="h2">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="rte vistil-benefits__text">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.bullet_1 != blank or block.settings.bullet_2 != blank or block.settings.bullet_3 != blank -%}
              <ul class="vistil-benefits__list list-unstyled">
                {%- if block.settings.bullet_1 != blank -%}
                  <li>{%- render 'icon-accordion', icon: 'checkmark' -%}<span>{{ block.settings.bullet_1 | escape }}</span></li>
                {%- endif -%}
                {%- if block.settings.bullet_2 != blank -%}
                  <li>{%- render 'icon-accordion', icon: 'checkmark' -%}<span>{{ block.settings.bullet_2 | escape }}</span></li>
                {%- endif -%}
                {%- if block.settings.bullet_3 != blank -%}
                  <li>{%- render 'icon-accordion', icon: 'checkmark' -%}<span>{{ block.settings.bullet_3 | escape }}</span></li>
                {%- endif -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "VISTIL: Benefits",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for real results"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit row",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Benefit heading" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Explain the benefit and why it matters to the customer.</p>" },
        { "type": "text", "id": "bullet_1", "label": "Bullet point 1" },
        { "type": "text", "id": "bullet_2", "label": "Bullet point 2" },
        { "type": "text", "id": "bullet_3", "label": "Bullet point 3" }
      ]
    }
  ],
  "presets": [
    {
      "name": "VISTIL: Benefits",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
