{% comment %}
  Sticky add-to-cart bar. Appears once the main product CTA has scrolled out of view
  and hides while another VISTIL CTA (offer, final CTA) is on screen.
  The button delegates to Dawn's product form via assets/vistil-product-bridge.js.
{% endcomment %}
{%- if product -%}
  {{ 'vistil-theme.css' | asset_url | stylesheet_tag }}
  {{ 'section-vistil-sticky-atc.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'vistil-product-bridge.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'vistil-sticky-atc.js' | asset_url }}" defer="defer"></script>

  {%- assign current_variant = product.selected_or_first_available_variant -%}
  {%- assign sticky_image = current_variant.featured_image | default: product.featured_image -%}

  <vistil-sticky-atc
    class="vistil-sticky-atc color-{{ section.settings.color_scheme }}{% unless section.settings.show_on_desktop %} vistil-sticky-atc--mobile-only{% endunless %}"
    data-product-title="{{ product.title | escape }}"
    aria-hidden="true"
  >
    <div class="page-width vistil-sticky-atc__inner">
      <div class="vistil-sticky-atc__product">
        {%- if sticky_image -%}
          <div class="vistil-sticky-atc__image">
            {{
              sticky_image
              | image_url: width: 160
              | image_tag: loading: 'lazy', alt: '', class: 'vistil-sticky-atc__thumb', width: 44, height: 44
            }}
          </div>
        {%- endif -%}
        <div class="vistil-sticky-atc__info">
          {%- if section.settings.urgency_text != blank -%}
            <p class="vistil-sticky-atc__urgency">{{ section.settings.urgency_text | escape }}</p>
          {%- endif -%}
          <p class="vistil-sticky-atc__title" data-vistil-sticky-title>{{ product.title | escape }}</p>
          <p class="vistil-sticky-atc__price" data-vistil-sticky-price>{{ current_variant.price | money }}</p>
        </div>
      </div>
      <div class="vistil-sticky-atc__cta">
        {%- render 'vistil-atc-button',
          product: product,
          label: section.settings.cta_label,
          sold_out_label: section.settings.sold_out_label,
          button_class: 'vistil-sticky-atc__submit'
        -%}
      </div>
    </div>
    {%- if section.settings.microcopy != blank -%}
      <p class="vistil-sticky-atc__microcopy">{{ section.settings.microcopy | escape }}</p>
    {%- endif -%}
  </vistil-sticky-atc>
{%- endif -%}

{% schema %}
{
  "name": "VISTIL: Sticky ATC",
  "class": "section",
  "settings": [
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Añadir al carrito" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Agotado" },
    { "type": "text", "id": "urgency_text", "label": "Compact urgency label", "info": "Only state scarcity that is true.", "default": "Últimas unidades" },
    { "type": "text", "id": "microcopy", "label": "Microcopy", "default": "Envío 24/48h · 90 días para devoluciones" },
    { "type": "checkbox", "id": "show_on_desktop", "label": "Show on desktop", "default": true },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "VISTIL: Sticky ATC"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
