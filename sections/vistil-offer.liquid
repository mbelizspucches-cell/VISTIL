{% comment %}
  Pack selector (1x / 2x ...) for the product page.
  Prices are computed from the real variant price. A tier only sets the quantity on
  Dawn's main product form; cart logic stays in Dawn (assets/vistil-product-bridge.js).
  A tier discount is display-only: it must mirror a real Shopify automatic discount.
{% endcomment %}
{{ 'vistil-theme.css' | asset_url | stylesheet_tag }}
{{ 'section-vistil-offer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vistil-product-bridge.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'vistil-offer.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if product -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  {%- assign tier_blocks = section.blocks | where: 'type', 'tier' -%}

  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      {%- if section.settings.heading != blank -%}
        <h2 class="vistil-heading vistil-center {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="vistil-subheading vistil-center rte">{{ section.settings.subheading }}</div>
      {%- endif -%}

      <vistil-offer class="vistil-offer">
        <fieldset class="vistil-offer__tiers">
          <legend class="vistil-visually-hidden">
            {{- section.settings.heading | default: product.title | strip_html | escape -}}
          </legend>

          {%- for block in tier_blocks -%}
            {%- liquid
              assign tier_quantity = block.settings.quantity | default: 1 | at_least: 1
              assign discount_cents = block.settings.discount_amount | times: 100 | round

              if block.settings.label != blank
                assign tier_label = block.settings.label
              else
                assign tier_label = tier_quantity | append: ' × ' | append: product.title
              endif

              assign tier_badge = block.settings.badge_text
              if tier_badge == blank and discount_cents > 0
                assign discount_money = discount_cents | money_without_trailing_zeros
                assign tier_badge = 'Ahorra ' | append: discount_money
              endif
            -%}
            <label
              class="vistil-offer__tier{% if block.settings.highlighted %} vistil-offer__tier--highlighted{% endif %}{% if forloop.first %} is-selected{% endif %}"
              data-vistil-tier
              {{ block.shopify_attributes }}
            >
              <input
                type="radio"
                class="vistil-offer__radio"
                name="VistilPack-{{ section.id }}"
                value="{{ tier_quantity }}"
                data-label="{{ tier_label | escape }}"
                {% if forloop.first %}
                  checked
                {% endif %}
              >
              <span class="vistil-offer__check" aria-hidden="true"></span>
              <span class="vistil-offer__tier-main">
                <span class="vistil-offer__tier-label">{{ tier_label | escape }}</span>
                {%- if block.settings.helper_text != blank -%}
                  <span class="vistil-offer__tier-helper">{{ block.settings.helper_text | escape }}</span>
                {%- endif -%}
              </span>
              <span class="vistil-offer__tier-price" data-tier-price>
                {%- render 'vistil-offer-price',
                  variant: current_variant,
                  quantity: tier_quantity,
                  discount_cents: discount_cents
                -%}
              </span>
              {%- if tier_badge != blank -%}
                <span class="vistil-offer__badge">{{ tier_badge | escape }}</span>
              {%- endif -%}
              <script type="application/json" data-tier-prices>
                {
                {%- for variant in product.variants -%}
                  {%- capture variant_price_html -%}
                    {%- render 'vistil-offer-price', variant: variant, quantity: tier_quantity, discount_cents: discount_cents -%}
                  {%- endcapture -%}
                  "{{ variant.id }}": {{ variant_price_html | strip | json }}{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
                }
              </script>
            </label>
          {%- endfor -%}
        </fieldset>

        {%- render 'vistil-atc-button',
          product: product,
          label: section.settings.cta_label,
          sold_out_label: section.settings.sold_out_label,
          button_class: 'vistil-offer__submit',
          quantity: tier_blocks.first.settings.quantity,
          watch: true
        -%}

        {%- if section.settings.reassurance_text != blank -%}
          <p class="vistil-offer__reassurance vistil-center">{{ section.settings.reassurance_text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.support_text != blank -%}
          <div class="vistil-offer__support vistil-center rte">{{ section.settings.support_text }}</div>
        {%- endif -%}
      </vistil-offer>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "VISTIL: Offer / pricing",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elige la opción que mejor encaje en tu hogar"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "cta_label", "label": "Add to cart button label", "default": "Añadir al carrito" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Agotado" },
    { "type": "text", "id": "reassurance_text", "label": "Microcopy below the button", "info": "Real, verifiable claims only.", "default": "Envío 24/48h desde España · 90 días para devoluciones · Pago seguro" },
    { "type": "richtext", "id": "support_text", "label": "Support copy", "default": "<p>Compra con tranquilidad. Si no encaja contigo, tienes 90 días para devolver tu pedido.</p>" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Pack",
      "settings": [
        { "type": "number", "id": "quantity", "label": "Units added to cart", "default": 1 },
        { "type": "text", "id": "label", "label": "Label", "info": "Leave blank to show \"[units] × [product title]\"." },
        {
          "type": "number",
          "id": "discount_amount",
          "label": "Pack discount (€)",
          "info": "Display only. Fill in ONLY after creating a matching automatic discount in Shopify (Discounts) for this quantity, otherwise the cart will charge the full price."
        },
        { "type": "text", "id": "badge_text", "label": "Badge text", "info": "Leave blank to show \"Ahorra [discount]\" automatically when a pack discount is set." },
        { "type": "text", "id": "helper_text", "label": "Helper text" },
        { "type": "checkbox", "id": "highlighted", "label": "Highlight this pack", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "VISTIL: Offer / pricing",
      "blocks": [
        { "type": "tier", "settings": { "quantity": 1 } },
        { "type": "tier", "settings": { "quantity": 2 } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
