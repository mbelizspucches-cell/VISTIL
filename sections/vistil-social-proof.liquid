{{ 'vistil-theme.css' | asset_url | stylesheet_tag }}
{{ 'section-vistil-social-proof.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
{%- assign logo_blocks = section.blocks | where: 'type', 'logo' -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding vistil-social-proof">
    {%- if section.settings.heading != blank -%}
      <p class="vistil-eyebrow vistil-center">{{ section.settings.heading | escape }}</p>
    {%- endif -%}

    {%- if stat_blocks.size > 0 -%}
      <div class="vistil-social-proof__stats">
        {%- for block in stat_blocks -%}
          <div class="vistil-social-proof__stat" {{ block.shopify_attributes }}>
            <p class="vistil-social-proof__stat-number">{{ block.settings.number | escape }}</p>
            <p class="vistil-social-proof__stat-label">{{ block.settings.label | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if logo_blocks.size > 0 -%}
      <ul class="vistil-social-proof__logos list-unstyled" role="list">
        {%- for block in logo_blocks -%}
          <li class="vistil-social-proof__logo" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 300
                | image_tag: loading: 'lazy', alt: block.settings.image.alt
              }}
            {%- else -%}
              <span class="vistil-social-proof__logo-placeholder">{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "VISTIL: Social proof",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Overline text",
      "info": "Only state real, verifiable claims here.",
      "default": "[PLACEHOLDER: overline trust statement]"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "info": "Use a real, verifiable figure only.",
          "default": "[PLACEHOLDER]"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "[PLACEHOLDER: e.g. verified reviews]"
        }
      ]
    },
    {
      "type": "logo",
      "name": "Press / logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Fallback text (if no image)",
          "default": "Visto en"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VISTIL: Social proof",
      "blocks": [
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
