{% comment %}
  Manually curated reviews section — no review-app dependency.
  Merchants add one "review" block per testimonial from the theme editor.
{% endcomment %}
{{ 'vistil-theme.css' | asset_url | stylesheet_tag }}
{{ 'section-vistil-reviews.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign review_blocks = section.blocks | where: 'type', 'review' -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="vistil-heading vistil-center {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.average_rating != blank -%}
      <div class="vistil-reviews__summary vistil-center">
        <span class="vistil-reviews__stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            {%- render 'icon-accordion', icon: 'star' -%}
          {%- endfor -%}
        </span>
        <p>
          <strong>{{ section.settings.average_rating }}/5</strong>
          {%- if section.settings.review_count != blank -%}
            &nbsp;·&nbsp;{{ section.settings.review_count | escape }} reviews
          {%- endif -%}
        </p>
      </div>
    {%- endif -%}

    {%- if review_blocks.size > 0 -%}
      <div class="vistil-reviews__grid vistil-grid">
        {%- for block in review_blocks -%}
          <div class="vistil-reviews__card" {{ block.shopify_attributes }}>
            {%- if block.settings.rating != blank -%}
              <span class="vistil-reviews__card-stars" aria-hidden="true">
                {%- assign rating_int = block.settings.rating | round -%}
                {%- for i in (1..5) -%}
                  {%- if i <= rating_int -%}
                    {%- render 'icon-accordion', icon: 'star' -%}
                  {%- endif -%}
                {%- endfor -%}
              </span>
              <span class="vistil-visually-hidden">{{ block.settings.rating }} out of 5 stars</span>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="vistil-reviews__card-text">&ldquo;{{ block.settings.text | escape }}&rdquo;</p>
            {%- endif -%}
            <div class="vistil-reviews__card-author">
              {%- if block.settings.avatar != blank -%}
                {{ block.settings.avatar | image_url: width: 80 | image_tag: loading: 'lazy', alt: block.settings.author }}
              {%- endif -%}
              <span>
                <strong>{{ block.settings.author | escape }}</strong>
                {%- if block.settings.verified -%}
                  <span class="vistil-reviews__verified">{%- render 'icon-accordion', icon: 'checkmark' -%}Verified buyer</span>
                {%- endif -%}
              </span>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "VISTIL: Reviews",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers are saying" },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    { "type": "text", "id": "average_rating", "label": "Average rating", "info": "Only enter your real, current average rating. Leave blank to hide.", "default": "" },
    { "type": "text", "id": "review_count", "label": "Review count", "info": "Only enter your real review count. Leave blank to hide.", "default": "" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review text", "info": "Paste a real customer review only — never fabricated.", "default": "[PLACEHOLDER: paste a real customer review]" },
        { "type": "text", "id": "author", "label": "Author name", "info": "Use the real customer's name (or their initials/first name for privacy).", "default": "[PLACEHOLDER: customer name]" },
        { "type": "checkbox", "id": "verified", "label": "Show verified buyer badge", "info": "Only enable if this is a genuine verified purchase.", "default": false },
        { "type": "image_picker", "id": "avatar", "label": "Avatar (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "VISTIL: Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
