{% comment %}
  Product demonstration: optional looping video, before/after compare slider
  and a gallery of real usage shots (blocks). Nothing is rendered on the
  storefront for media that hasn't been uploaded yet; placeholders only show
  in the Theme Editor.
{% endcomment %}
{{ 'vistil-theme.css' | asset_url | stylesheet_tag }}
{{ 'section-vistil-transformation.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign has_compare = false
  if section.settings.before_image != blank and section.settings.after_image != blank
    assign has_compare = true
  endif
  assign show_compare = has_compare
  if request.design_mode
    assign show_compare = true
  endif
  assign media_blocks = section.blocks | where: 'type', 'media'
  assign visible_media_count = 0
  for block in media_blocks
    if block.settings.image != blank or request.design_mode
      assign visible_media_count = visible_media_count | plus: 1
    endif
  endfor
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="vistil-transformation__intro vistil-center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vistil-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="vistil-heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="vistil-subheading rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.video != blank -%}
      <div class="vistil-transformation__video">
        {{
          section.settings.video
          | video_tag:
            image_size: '1200x',
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            preload: 'metadata'
        }}
      </div>
    {%- endif -%}

    {%- if show_compare -%}
      <script src="{{ 'vistil-transformation.js' | asset_url }}" defer="defer"></script>
      <vistil-transformation class="vistil-transformation">
        <div class="vistil-transformation__frame">
          <div class="vistil-transformation__image vistil-transformation__image--after">
            {%- if section.settings.after_image != blank -%}
              {{ section.settings.after_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.after_label, sizes: '(min-width: 990px) 900px, 100vw', widths: '600, 900, 1200, 1400' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <span class="vistil-transformation__tag vistil-transformation__tag--after">{{ section.settings.after_label | escape }}</span>
          </div>
          <div class="vistil-transformation__image vistil-transformation__image--before" data-vistil-before-panel>
            {%- if section.settings.before_image != blank -%}
              {{ section.settings.before_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.before_label, sizes: '(min-width: 990px) 900px, 100vw', widths: '600, 900, 1200, 1400' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <span class="vistil-transformation__tag vistil-transformation__tag--before">{{ section.settings.before_label | escape }}</span>
          </div>
          <input
            type="range"
            class="vistil-transformation__slider"
            min="0"
            max="100"
            value="50"
            aria-label="{{ section.settings.slider_label | escape }}"
            data-vistil-slider
          >
        </div>
      </vistil-transformation>
    {%- endif -%}

    {%- if visible_media_count > 0 -%}
      <div class="vistil-transformation__gallery vistil-grid">
        {%- for block in media_blocks -%}
          {%- if block.settings.image != blank or request.design_mode -%}
            <figure class="vistil-transformation__gallery-item" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.caption, sizes: '(min-width: 750px) 33vw, 100vw', widths: '400, 600, 800, 1000' }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <figcaption>{{ block.settings.caption | escape }}</figcaption>
              {%- endif -%}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.microclaim != blank or section.settings.support_text != blank -%}
      <div class="vistil-transformation__claim vistil-center">
        {%- if section.settings.microclaim != blank -%}
          <p class="h4">{{ section.settings.microclaim | escape }}</p>
        {%- endif -%}
        {%- if section.settings.support_text != blank -%}
          <p class="vistil-transformation__support">{{ section.settings.support_text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "VISTIL: Transformation",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Demostración real" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lo que no ves, sale a la vista." },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    { "type": "richtext", "id": "text", "label": "Text" },
    {
      "type": "header",
      "content": "Video (optional)"
    },
    { "type": "video", "id": "video", "label": "Looping video", "info": "Plays muted and on loop. Use real product footage only." },
    {
      "type": "header",
      "content": "Before / after (optional)"
    },
    { "type": "paragraph", "content": "The compare slider appears once both images are uploaded." },
    { "type": "image_picker", "id": "before_image", "label": "Before image" },
    { "type": "text", "id": "before_label", "label": "Before label", "default": "Antes" },
    { "type": "image_picker", "id": "after_image", "label": "After image" },
    { "type": "text", "id": "after_label", "label": "After label", "default": "Después" },
    { "type": "text", "id": "slider_label", "label": "Slider accessibility label", "default": "Desliza para comparar antes y después" },
    {
      "type": "header",
      "content": "Closing"
    },
    { "type": "text", "id": "microclaim", "label": "Micro claim" },
    { "type": "text", "id": "support_text", "label": "Support text" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Usage image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Real VISTIL Fabric usage: mattress, sofa, visible tank, etc." },
        { "type": "text", "id": "caption", "label": "Caption / alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "VISTIL: Transformation"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
