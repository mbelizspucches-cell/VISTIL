{% comment %}
  Trust section: heading, trust items (icon + title + text), optional inline badges,
  up to two real photos and a closing line. Theme Editor images always take priority
  over the approved photos shipped with the theme (fallback_image / fallback_image_2).
{% endcomment %}
{{ 'vistil-theme.css' | asset_url | stylesheet_tag }}
{{ 'section-vistil-trust-guarantee.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign item_blocks = section.blocks | where: 'type', 'trust_item'
  assign badge_blocks = section.blocks | where: 'type', 'badge'

  assign media_count = 0
  if section.settings.image != blank or section.settings.fallback_image != 'none'
    assign media_count = media_count | plus: 1
  endif
  if section.settings.image_2 != blank or section.settings.fallback_image_2 != 'none'
    assign media_count = media_count | plus: 1
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="vistil-trust__intro vistil-center">
        {%- if section.settings.heading != blank -%}
          <h2 class="vistil-heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="vistil-subheading rte">{{ section.settings.subheading }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if item_blocks.size > 0 -%}
      <ul class="vistil-trust__items list-unstyled" role="list">
        {%- for block in item_blocks -%}
          <li class="vistil-trust__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <div class="vistil-icon vistil-trust__item-icon">{%- render 'icon-accordion', icon: block.settings.icon -%}</div>
            {%- endif -%}
            <div>
              {%- if block.settings.title != blank -%}
                <h3 class="h5 vistil-trust__item-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="vistil-trust__item-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if badge_blocks.size > 0 -%}
      <ul class="vistil-trust__badges list-unstyled" role="list">
        {%- for block in badge_blocks -%}
          <li class="vistil-trust__badge" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <div class="vistil-icon">{%- render 'icon-accordion', icon: block.settings.icon -%}</div>
            {%- endif -%}
            <span>{{ block.settings.text | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if media_count > 0 -%}
      <div class="vistil-trust__media-row vistil-trust__media-row--{{ media_count }}">
        {%- render 'vistil-trust-media',
          image: section.settings.image,
          alt: section.settings.image_alt,
          fallback: section.settings.fallback_image
        -%}
        {%- render 'vistil-trust-media',
          image: section.settings.image_2,
          alt: section.settings.image_2_alt,
          fallback: section.settings.fallback_image_2
        -%}
      </div>
    {%- endif -%}

    {%- if section.settings.closing_heading != blank or section.settings.closing_text != blank -%}
      <div class="vistil-trust__closing vistil-center">
        {%- if section.settings.closing_heading != blank -%}
          <p class="h3 vistil-trust__closing-heading">{{ section.settings.closing_heading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.closing_text != blank -%}
          <div class="rte">{{ section.settings.closing_text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "VISTIL: Trust & guarantee",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compra con tranquilidad." },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    {
      "type": "header",
      "content": "Images (optional)"
    },
    { "type": "image_picker", "id": "image", "label": "Image 1", "info": "Real photo, e.g. guarantee/returns or shipping." },
    { "type": "text", "id": "image_alt", "label": "Image 1 alt text" },
    {
      "type": "select",
      "id": "fallback_image",
      "label": "Image 1 default (until you upload one)",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "guarantee", "label": "Guarantee / returns photo" },
        { "value": "shipping", "label": "Shipping photo" }
      ],
      "default": "none"
    },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "text", "id": "image_2_alt", "label": "Image 2 alt text" },
    {
      "type": "select",
      "id": "fallback_image_2",
      "label": "Image 2 default (until you upload one)",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "guarantee", "label": "Guarantee / returns photo" },
        { "value": "shipping", "label": "Shipping photo" }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Closing"
    },
    { "type": "text", "id": "closing_heading", "label": "Closing heading" },
    { "type": "richtext", "id": "closing_text", "label": "Closing text" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "padlock", "label": "Padlock" },
            { "value": "lock", "label": "Lock" },
            { "value": "chat_bubble", "label": "Chat bubble" },
            { "value": "checkmark", "label": "Checkmark" }
          ],
          "default": "checkmark"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Título" },
        { "type": "textarea", "id": "text", "label": "Text", "info": "Real, verifiable claims only." }
      ]
    },
    {
      "type": "badge",
      "name": "Inline badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "lock", "label": "Lock" },
            { "value": "padlock", "label": "Padlock" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "checkmark", "label": "Checkmark" }
          ],
          "default": "lock"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Pago seguro" }
      ]
    }
  ],
  "presets": [
    {
      "name": "VISTIL: Trust & guarantee",
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "truck" } },
        { "type": "trust_item", "settings": { "icon": "return" } },
        { "type": "trust_item", "settings": { "icon": "padlock" } },
        { "type": "trust_item", "settings": { "icon": "chat_bubble" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
